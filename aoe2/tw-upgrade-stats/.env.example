# Absolute path to the 845_Localization Fix mod's zh source file.
# Find it under Steam's per-account mods folder, e.g.:
#   ~/Library/Application Support/Feral Interactive/Age Of Empires II/VFS/User/Games/
#     Age of Empires 2 DE/<your SteamID64>/mods/subscribed/
#     845_Localization Fix and Enhanced Data Tooltip/resources/zh/strings/key-value/
#     key-value-modded-strings-utf8.txt
AOE2_845_SOURCE_FILE="/path/to/845_Localization Fix and Enhanced Data Tooltip/resources/zh/strings/key-value/key-value-modded-strings-utf8.txt"

# Optional — override if your Steam library isn't in the default location.
# AOE2_GAME_DATA_DIR="~/Library/Application Support/Steam/steamapps/common/AoE2DE/AgeOfEmpires2Data"
